# keep the build context small + force clean rebuilds of generated stuff
.git
.venv
mlruns
mlflow.db
logs
**/__pycache__
**/*.pyc
.pytest_cache

# node / next (the web stage runs npm ci + build fresh)
app/dashboard/node_modules
app/dashboard/.next
app/dashboard/out

# local data + artifacts (the trainer stage regenerates these in-image)
creditcast/data/bronze
creditcast/data/silver
creditcast/data/gold
creditcast/data/macro
creditcast/artifacts
creditcast/reports/*.html

# docs/CI not needed in the image
.github
*.md
!creditcast/governance/model_card.md
